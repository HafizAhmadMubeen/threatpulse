{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreatPulse Event",
  "description": "One object per line in events.jsonl (PLANNING.md Section 5.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "ts",
    "host",
    "source",
    "event_type",
    "pid",
    "ppid",
    "process",
    "target"
  ],
  "properties": {
    "event_id": {
      "description": "e-<run start, UTC, yyyymmddThhmmss>-<counter, at least 6 digits>. Unique across runs.",
      "type": "string",
      "pattern": "^e-[0-9]{8}T[0-9]{6}-[0-9]{6,}$"
    },
    "ts": {
      "description": "UTC ISO 8601 with milliseconds.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "host": { "type": "string", "minLength": 1 },
    "source": { "enum": ["etw", "sysmon", "fim"] },
    "event_type": {
      "enum": [
        "process_start",
        "process_stop",
        "process_access",
        "file_create",
        "file_write",
        "file_rename",
        "file_delete",
        "registry_set",
        "registry_delete",
        "network_connect",
        "fim_change"
      ]
    },
    "pid": { "type": "integer", "minimum": 0 },
    "ppid": {
      "description": "0 when the parent is unknown.",
      "type": "integer",
      "minimum": 0
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "cmdline", "user", "sha256", "signed", "signer"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "cmdline": { "type": ["string", "null"] },
        "user": { "type": ["string", "null"] },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "signed": {
          "description": "True only for a verified signature. A failed check is false.",
          "type": "boolean"
        },
        "signer": { "type": ["string", "null"] },
        "microsoft_root": {
          "description": "True only when the signature verified and the certificate chain ends at a Microsoft root. Checked by the agent, never taken from the signer text. Optional: recordings made before it existed lack it, and absent means unknown, not false.",
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "registry_key",
        "pid",
        "access_mask",
        "dest_ip",
        "dest_port"
      ],
      "properties": {
        "path": {
          "description": "For file_rename, the new path. For file_delete, the deleted file. For process_access, the target's image.",
          "type": ["string", "null"]
        },
        "old_path": {
          "description": "The previous path. Set only for file_rename.",
          "type": ["string", "null"]
        },
        "registry_key": { "type": ["string", "null"] },
        "pid": { "type": ["integer", "null"], "minimum": 0 },
        "access_mask": {
          "description": "The raw mask as a hex string, for example 0x1010.",
          "type": ["string", "integer", "null"]
        },
        "access_rights": {
          "description": "The decoded access_mask, for example vm_read. Set only for process_access.",
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "dest_ip": { "type": ["string", "null"] },
        "dest_port": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 65535
        },
        "change": {
          "description": "What changed. Set only for fim_change. Files give SHA-256 values, registry values give the data.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind", "old_value", "new_value"],
          "properties": {
            "kind": { "enum": ["added", "modified", "removed"] },
            "old_value": { "type": ["string", "null"] },
            "new_value": { "type": ["string", "null"] }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "file_rename" } } },
      "else": {
        "properties": {
          "target": { "properties": { "old_path": { "type": "null" } } }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["registry_set", "registry_delete"] } } },
      "then": {
        "properties": {
          "target": { "properties": { "registry_key": { "type": "string" } } }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "fim_change" } } },
      "then": {
        "properties": {
          "target": {
            "required": ["change"],
            "properties": { "change": { "type": "object" } }
          }
        }
      },
      "else": {
        "properties": {
          "target": { "properties": { "change": { "type": "null" } } }
        }
      }
    }
  ]
}
